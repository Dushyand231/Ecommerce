# Server
PORT=5000
NODE_ENV=development

# MongoDB (use Atlas for production or local for development)
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/shopsphere?retryWrites=true&w=majority

# Auth
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# CORS (comma separated allowed origins, e.g. http://localhost:5173,https://yourapp.vercel.app)
CLIENT_ORIGIN=http://localhost:5173

# Image storage (optional: if omitted, images are saved to /uploads locally)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (test mode keys; payment available only when set)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=